# ══════════════════════════════════════════════════════════════
#  SUVI ✦ ಸುವಿ — Smart Unified Voice Intelligence  v3.0
#  Configuration File — Copy this to .env and fill in values
# ══════════════════════════════════════════════════════════════

APP_NAME="SUVI - Smart Unified Voice Intelligence"
APP_VERSION="3.0.0"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# ── Security ──────────────────────────────────────────────────
SECRET_KEY="suvi-jarvis-super-secret-key-change-in-production-2026"
MASTER_PIN="1234"
API_TOKEN="suvi-core-token-secure-v2"

# ── Voice / TTS Engine (Lady Voice) ───────────────────────────
# Female neural voices available:
#   en-US-JennyNeural    ← warm US lady voice (DEFAULT)
#   en-US-AriaNeural     ← expressive US female
#   en-IN-NeerjaNeural   ← Indian lady voice (great for Kannada names)
#   en-GB-SoniaNeural    ← British lady voice
#   en-US-MichelleNeural ← professional US female
DEFAULT_TTS_VOICE="en-US-JennyNeural"
FALLBACK_TTS_VOICE="en-IN-NeerjaNeural"
TTS_RATE="+5%"
TTS_PITCH="+3Hz"

# ── Wake Word (Kannada: ಸುವಿ = "Soo-vee") ────────────────────
# Say: "Hey Suvi" or "Hey ಸುವಿ" to activate SUVI
# Speech engines may hear: suvi, suvii, souvi, soobi, suby
WAKE_WORD="hey suvi"
WAKE_WORD_KANNADA="hey ಸುವಿ"
WAKE_WORD_ALIASES="suvi,hey suvii,hey souvi,hey soobi,hey suby"

# ── Android ADB Bridge ────────────────────────────────────────
ADB_PATH="adb"
ANDROID_DEVICE_IP=""   # e.g. "192.168.1.105:5555" for wireless ADB

# ── 🧠 Gemini AI Brain (PRIMARY INTELLIGENCE) ────────────────
# ► Get your FREE API key at: https://aistudio.google.com/apikey
# ► This powers SUVI's full intelligence — conversations, device
#   control, multi-turn memory, and natural language understanding
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_MAX_HISTORY=40

# ── Optional: OpenAI Fallback ─────────────────────────────────
OPENAI_API_KEY=""
